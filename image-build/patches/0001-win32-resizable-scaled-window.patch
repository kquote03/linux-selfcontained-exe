+// Round 5 (LinuxLab): composes the current frame into an off-screen
+// memory DC sized to the live client area (scaling into it, letterboxed,
+// if the window has been resized away from the framebuffer's native
+// size - see win32_compute_fit()), then presents it with a single BitBlt.
+// Double-buffering this way - rather than erasing/drawing straight on
+// the window DC - is what actually fixes the resize flicker: a direct-
+// to-screen draw is visible mid-composition (briefly black, then the
+// picture), especially when WM_SIZE below re-triggers it on every step
+// of a live drag; one atomic BitBlt never shows a partial frame.
+//
+// Also called directly from win32_wndproc()'s WM_SIZE handler (not just
+// from the normal RVVM poll()/draw() loop) using the last-known
+// framebuffer (win32->fb) - Windows runs its own modal loop for an
+// interactive border-drag resize, which blocks RVVM's own loop from
+// running, so without this the window frame would resize instantly while
+// the picture inside only caught up once the drag ended.
+static void win32_present(win32_window_t* win32)
+{
+    const rvvm_fb_t* fb = &win32->fb;
+    if (!win32->hdc || !rvvm_fb_buffer(fb)) {
+        return;
+    }
+
+    RECT client = ZERO_INIT;
+    GetClientRect(win32->hwnd, &client);
+    int client_w = (int)(client.right - client.left);
+    int client_h = (int)(client.bottom - client.top);
+    if (client_w <= 0 || client_h <= 0) {
+        return;
+    }
+
+    uint32_t    fb_w = rvvm_fb_width(fb);
+    uint32_t    fb_h = rvvm_fb_height(fb);
+    win32_fit_t fit  = win32_compute_fit(win32->hwnd, fb_w, fb_h);
+
+    HDC     mem_dc  = CreateCompatibleDC(win32->hdc);
+    HBITMAP mem_bmp = CreateCompatibleBitmap(win32->hdc, client_w, client_h);
+    HBITMAP old_bmp = (HBITMAP)SelectObject(mem_dc, mem_bmp);
+
+    BITMAPINFO* bmi = (BITMAPINFO*)safe_calloc(1, sizeof(BITMAPINFO) + (sizeof(DWORD) * 3));
+    bmi->bmiHeader.biSize     = sizeof(BITMAPINFOHEADER);
+    bmi->bmiHeader.biWidth    = rvvm_fb_stride(fb) / rvvm_fb_rgb_bytes(fb);
+    bmi->bmiHeader.biHeight   = -(int)fb_h;
+    bmi->bmiHeader.biPlanes   = 1;
+    bmi->bmiHeader.biBitCount = rvvm_fb_rgb_bpp(fb);
+    if (win32_handle_formats(bmi, fb)) {
+        bmi->bmiHeader.biCompression = BI_BITFIELDS;
+    }
+
+    if (fit.dest_w != fb_w || fit.dest_h != fb_h || fit.off_x || fit.off_y) {
+        RECT full = { 0, 0, client_w, client_h };
+        FillRect(mem_dc, &full, (HBRUSH)GetStockObject(BLACK_BRUSH));
+        SetStretchBltMode(mem_dc, HALFTONE);
+        SetBrushOrgEx(mem_dc, 0, 0, NULL);
+        StretchDIBits(mem_dc, fit.off_x, fit.off_y, (int)fit.dest_w, (int)fit.dest_h, //
+                     0, 0, (int)fb_w, (int)fb_h, rvvm_fb_buffer(fb), bmi, DIB_RGB_COLORS, SRCCOPY);
+    } else {
+        SetDIBitsToDevice(mem_dc, 0, 0, fb_w, fb_h, 0, 0, 0, //
+                          fb_h, rvvm_fb_buffer(fb), bmi, DIB_RGB_COLORS);
+    }
+    safe_free(bmi);
+
+    BitBlt(win32->hdc, 0, 0, client_w, client_h, mem_dc, 0, 0, SRCCOPY);
+
+    SelectObject(mem_dc, old_bmp);
+    DeleteObject(mem_bmp);
+    DeleteDC(mem_dc);
+}
