# Large fetched/built binary assets — never committed, rebuilt from packaging/payload-manifest.json
assets/*
!assets/.gitkeep

# Build outputs
image-build/out/
packaging/out/
*.exe
*.img
*.img.zst
*.img.xz

# Go
launcher/*.exe
launcher/dist/

# Leftover manual test scratch dirs
scratch_pkgtest/

# Editor/OS cruft
.vscode/
*.log
Thumbs.db

# Claude Code local session/plan state - not project content
.claude/

# Hardware reports supplied for tuning reference - contain machine-
# identifying data (DMI UUID/serial), kept local rather than committed
cpuz-report.txt
