+// Round 5 (LinuxLab): aspect-ratio-preserving "fit" computation shared by
+// win32_present() (scaled blit) and the WM_MOUSEMOVE handler (inverse-
+// mapping client coords back to framebuffer coords), so a resized
+// window's pointer position stays aligned with what's drawn. Centered
+// (letterboxed/pillarboxed) - same convention as a typical video player's
+// "scaled" view, not a stretch-to-fill that distorts.
+typedef struct {
+    uint32_t dest_w, dest_h;
+    int32_t  off_x, off_y;
+    double   scale;
+} win32_fit_t;
+
+static win32_fit_t win32_compute_fit(HWND hwnd, uint32_t fb_w, uint32_t fb_h)
+{
+    win32_fit_t fit = { fb_w, fb_h, 0, 0, 1.0 };
+    RECT client = ZERO_INIT;
+    if (fb_w && fb_h && GetClientRect(hwnd, &client)) {
+        uint32_t client_w = (uint32_t)(client.right - client.left);
+        uint32_t client_h = (uint32_t)(client.bottom - client.top);
+        if (client_w && client_h) {
+            double sx    = (double)client_w / fb_w;
+            double sy    = (double)client_h / fb_h;
+            double scale = (sx < sy) ? sx : sy;
+            if (scale > 0.0) {
+                fit.scale  = scale;
+                fit.dest_w = (uint32_t)(fb_w * scale);
+                fit.dest_h = (uint32_t)(fb_h * scale);
+                fit.off_x  = (int32_t)((client_w - fit.dest_w) / 2);
+                fit.off_y  = (int32_t)((client_h - fit.dest_h) / 2);
+            }
+        }
+    }
+    return fit;
+}
+
+// Forward-declared: defined after win32_handle_formats() below, but
+// win32_wndproc() (defined next) needs to call it from its WM_SIZE
+// handler, to keep content in sync during a *live* interactive resize
+// drag - RVVM's own poll()/draw() loop doesn't run while Windows' modal
+// resize loop has control, so without this the window frame resizes
+// instantly but the picture inside it only catches up once the drag
+// ends, which reads as a flicker/flash between the two.
+static void win32_present(win32_window_t* win32);
